# Auth — required, shared secret, minimum 32 characters.
# The app refuses to start if this is empty or too short.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ASTRO_API_KEY=

# Geocoding (Nominatim / OpenStreetMap)
NOMINATIM_USER_AGENT=astro-api/1.0 (aphillipsr@gmail.com)
NOMINATIM_TIMEOUT_SECONDS=5

# Astrology defaults
DEFAULT_HOUSE_SYSTEM=placidus
DEFAULT_LOCALE=en_US

# Server
PORT=8000
LOG_LEVEL=info

# Public base URL — used to populate OpenAPI `servers`, which is how an MCP
# client learns where to send requests. Optional: falls back to Railway's
# injected RAILWAY_PUBLIC_DOMAIN, then to http://127.0.0.1:8000. Set it only
# for a custom domain or a host that injects nothing.
PUBLIC_BASE_URL=
